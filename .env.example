# ── Database ──────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL="file:./db/custom.db"

# Vercel production (use Turso / PlanetScale / Neon):
# DATABASE_URL="libsql://your-db.turso.io?authToken=your-token"

# ── ZAI SDK (Chatbot — no API key needed) ────────────
# The chatbot uses z-ai-web-dev-sdk which works out of the box.
# ZAI_API_KEY=